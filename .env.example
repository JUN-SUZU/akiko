# Cloudflare Access で公開する場合の設定例。
# このファイルを .env にコピーし、以下の URL と AUD を実際の値に置き換えてください。
AUTH_MODE=access
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=your-application-aud
PUBLIC_ORIGIN=https://akiko.example.com

# 同じサーバー上のリバースプロキシからのみ接続する場合。
HOST=127.0.0.1
PORT=3000

# 必要な場合だけ設定します。
# DATA_DIR=data
# BASE_PATH=
